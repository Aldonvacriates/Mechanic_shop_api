{
  "info": {
    "_postman_id": "a1d5f8d2-3f7e-4f22-9b2e-0c91a4b7c123",
    "name": "Mechanic Shop API",
    "description": "Postman collection for the Mechanic Shop API (Flask, SQLAlchemy, Marshmallow, Blueprints, App Factory). Covers CRUD, JWT auth (customer + mechanic), rate limiting, caching, advanced queries, and the Inventory resource. Login requests auto-save tokens into the {{customer_token}} and {{mechanic_token}} collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "48725908"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "customer_token", "value": "" },
    { "key": "mechanic_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Login routes for customers and mechanics. Each saves its JWT into a collection variable used by protected requests.",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('customer_token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "description": "Validate email + password (login_schema) and return a customer JWT.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aldo@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/customers/login",
              "host": ["{{base_url}}"],
              "path": ["customers", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Mechanic Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('mechanic_token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "description": "Validate mechanic email + password and return a mechanic-scoped JWT (role=mechanic).",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mike@example.com\",\n  \"password\": \"secret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/mechanics/login",
              "host": ["{{base_url}}"],
              "path": ["mechanics", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "description": "CRUD requests for customer resources. Update/Delete require a customer Bearer token (id comes from the token).",
      "item": [
        {
          "name": "Get All Customers (paginated)",
          "request": {
            "description": "Retrieve a page of customers. Supports ?page and ?per_page. Response is cached for 60s per page.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["customers", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Specific Customer",
          "request": {
            "description": "Retrieve one customer by ID.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers/1",
              "host": ["{{base_url}}"],
              "path": ["customers", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Create Customer",
          "request": {
            "description": "Create a new customer. Rate limited to 5/min. Include a password to enable login.",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Aldo\",\n  \"last_name\": \"Herrera\",\n  \"email\": \"aldo@example.com\",\n  \"password\": \"secret123\",\n  \"phone\": \"5713565892\",\n  \"address_line1\": \"5669 S 1150 W\",\n  \"city\": \"Riverdale\",\n  \"state\": \"UT\",\n  \"postal_code\": \"84405\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/customers/",
              "host": ["{{base_url}}"],
              "path": ["customers", ""]
            }
          },
          "response": []
        },
        {
          "name": "My Tickets (token required)",
          "request": {
            "description": "Return service tickets belonging to the authenticated customer. customer_id comes from the Bearer token.",
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/customers/my-tickets",
              "host": ["{{base_url}}"],
              "path": ["customers", "my-tickets"]
            }
          },
          "response": []
        },
        {
          "name": "Update Customer (token required)",
          "request": {
            "description": "Update the authenticated customer. id is taken from the token, not the URL.",
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{customer_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"8015557777\",\n  \"city\": \"Ogden\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/customers/",
              "host": ["{{base_url}}"],
              "path": ["customers", ""]
            }
          },
          "response": []
        },
        {
          "name": "Delete Customer (token required)",
          "request": {
            "description": "Delete the authenticated customer. id is taken from the token.",
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/customers/",
              "host": ["{{base_url}}"],
              "path": ["customers", ""]
            }
          },
          "response": []
        }
      ]
    },
